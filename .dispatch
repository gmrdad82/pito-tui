name = "pito-tui"
mac_overflow = true

[gate]
fast = "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings"
full = "bin/gate"

[commands]
release = ""
deploy = ""

[[test_track.jobs]]
name = "gate"
command = "bin/gate --shard {shard}/{shards}"
split = true

[[test_track.jobs]]
name = "signals-linux-only"
command = "cargo nextest run --all-features --no-tests=pass --test signals"
needs = ["os:linux"]
