name = "pito-tui"
mac_overflow = true

[gate]
fast = "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings"
full = "bin/gate"

[commands]
release = ""
deploy = ""

[[test_track.jobs]]
name = "gate"
command = "bin/gate"
needs = ["os:linux"]

[[test_track.jobs]]
name = "mac"
command = "bin/gate --fast"
needs = ["os:macos"]
